function blocked(nx,ny){
  const tx=Math.floor(nx/TILE),ty=Math.floor(ny/TILE);
  if(tx<0||ty<0||tx>=MAP_W||ty>=MAP_H)return true;
  if(map[ty][tx]===T.WATER)return true;
  for(const s of structures){
    const left=s.x*TILE,top=s.y*TILE,right=(s.x+s.w)*TILE,bottom=(s.y+s.h)*TILE;
    // malé dveřní mezery u chaty a věže
    const doorGap=(s.type==='cabin'&&tx===65&&ty===40)||(s.type==='tower'&&tx===109&&ty===27)||(s.type==='station'&&tx===47&&ty===87);
    if(nx>left+6&&nx<right-6&&ny>top+6&&ny<bottom-6&&!doorGap)return true;
  }
  return false;
}

function update(dt){
  if(!overlayOpen){
    let dx=(keys['d']||keys['arrowright']?1:0)-(keys['a']||keys['arrowleft']?1:0);
    let dy=(keys['s']||keys['arrowdown']?1:0)-(keys['w']||keys['arrowup']?1:0);
    if(dx||dy){const l=Math.hypot(dx,dy);dx/=l;dy/=l;player.facingX=dx;player.facingY=dy;const sp=player.speed*dt;
      const nx=player.x+dx*sp;if(!blocked(nx,player.y))player.x=nx;
      const ny=player.y+dy*sp;if(!blocked(player.x,ny))player.y=ny;
    }
    state.time=(state.time+dt*2.1)%(24*60);
    if(state.flashlight){state.battery=Math.max(0,state.battery-dt*0.52);if(state.battery<=0){state.flashlight=false;toast('Baterka se vybila.')}}
  }

  for(const p of particles){
    p.phase+=dt*2;
    if(p.type==='firefly'){
      p.x+=Math.sin(p.phase+p.y*.01)*8*dt+p.vx*dt*0.3;
      p.y+=Math.cos(p.phase*.7+p.x*.01)*6*dt+p.vy*dt*0.3;
    } else if(p.type==='dust'){
      p.x+=p.vx*dt*.4;
      p.y+=p.vy*dt*.4;
      p.vy+=dt*.5;
      if(p.vy>8)p.vy=0;
    } else {
      p.x+=p.vx*dt;
      p.y+=p.vy*dt+Math.sin(p.phase)*dt*4;
      p.vy+=dt*2;
    }
    if(p.x<0)p.x=MAP_W*TILE;if(p.x>MAP_W*TILE)p.x=0;
    if(p.y<-20){p.y=MAP_H*TILE;p.vy=(rng()-.5)*4-2;}
    if(p.y>MAP_H*TILE+20){p.y=-20;p.vy=(rng()-.5)*4-2;}
  }

  nearest=null;let best=99999;
  for(const o of interactables){if(!o.active)continue;const d=dist(player.x,player.y,o.x,o.y);if(d<o.radius&&d<best){best=d;nearest=o}}
  const p=document.getElementById('prompt');
  if(nearest&&!overlayOpen){p.textContent=nearest.prompt;p.style.display='block'}else p.style.display='none';

  updateQuestProgress();
  document.getElementById('batteryText').textContent=Math.round(state.battery)+'%';
  document.getElementById('batteryBar').style.width=state.battery+'%';
  document.getElementById('questText').textContent=quests[state.questStage]||'Příběh dokončen.';
  const h=Math.floor(state.time/60),m=Math.floor(state.time%60);document.getElementById('timeText').textContent=`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
  document.getElementById('zoneText').textContent=getZone();
}

function getZone(){
  const tx=player.x/TILE,ty=player.y/TILE;
  if(dist(tx,ty,25,28)<13)return 'Vesnice Hvozd';
  if(dist(tx,ty,65,39)<10)return 'Lesní chata';
  if(dist(tx,ty,110,25)<12)return 'Reléová stanice';
  if(dist(tx,ty,130,82)<13)return 'Starý lom';
  if(dist(tx,ty,47,87)<12)return 'Opuštěná zastávka';
  if(tx>80&&ty>67&&tx<106&&ty<94)return 'Jezero';
  return map[Math.floor(ty)]?.[Math.floor(tx)]===T.DIRT?'Lesní cesta':'Les';
}

function camera(){return {x:clamp(player.x-canvas.width/2,0,MAP_W*TILE-canvas.width),y:clamp(player.y-canvas.height/2,0,MAP_H*TILE-canvas.height)}}
function render(){
  const c=camera();ctx.clearRect(0,0,canvas.width,canvas.height);
  const sx=Math.floor(c.x/TILE),sy=Math.floor(c.y/TILE),ex=Math.ceil((c.x+canvas.width)/TILE),ey=Math.ceil((c.y+canvas.height)/TILE);
  for(let y=sy;y<=ey;y++)for(let x=sx;x<=ex;x++){
    if(x<0||y<0||x>=MAP_W||y>=MAP_H)continue;const px=x*TILE-c.x,py=y*TILE-c.y;drawTile(map[y][x],px,py,x,y);
  }
  for(const s of structures)drawStructure(s,c);
  for(const t of trees){const px=t.x*TILE-c.x,py=t.y*TILE-c.y;if(px<-50||py<-70||px>canvas.width+50||py>canvas.height+50)continue;drawTree(px,py,t.s)}
  for(const o of interactables)if(o.active&&o.draw)drawInteractable(o,c);
  drawParticles(c);
  drawPlayer(c);
  drawDarkness(c);
  drawMiniMap();
}

function drawTile(type,x,y,tx,ty){
  const baseColors=['#3a6b44','#2a4f33','#7a746a','#5e4d3a','#1e4553','#2d3437','#63686b'];
  ctx.fillStyle=baseColors[type];ctx.fillRect(x,y,TILE+1,TILE+1);

  const hash=((tx*928371+ty*364479)&255)/255;
  const hash2=((tx*411031+ty*871237)&255)/255;

  if(type===T.GRASS){
    ctx.fillStyle='rgba(120,170,90,.10)';
    for(let i=0;i<5;i++){
      const gx=x+((hash*31+i*7)%TILE),gy=y+((hash2*23+i*11)%TILE);
      ctx.fillRect(gx,gy,2,4);
    }
    ctx.fillStyle='rgba(50,85,45,.15)';
    ctx.fillRect(x+(hash*18)%20,y+8+((tx+ty)%12),3,2);
    if((tx*17+ty*31)%9===0){ctx.fillStyle='rgba(235,245,215,.07)';ctx.fillRect(x+20,y+20,5,2)}
    if(hash>.85){ctx.fillStyle='rgba(255,255,200,.12)';ctx.fillRect(x+(hash*24)%24,y+(hash2*24)%24,2,2)}
  }
  if(type===T.FOREST){
    ctx.fillStyle='rgba(15,40,22,.18)';
    for(let i=0;i<4;i++){
      ctx.fillRect(x+((hash*29+i*9)%TILE),y+((hash2*27+i*13)%TILE),3,3);
    }
    ctx.fillStyle='rgba(8,25,12,.12)';
    ctx.fillRect(x+(hash2*20)%22,y+5+((tx*3+ty)%14),4,3);
  }
  if(type===T.ROAD||type===T.DIRT){
    const isRoad=type===T.ROAD;
    ctx.fillStyle=isRoad?'rgba(255,255,255,.05)':'rgba(255,240,210,.04)';
    ctx.fillRect(x,y+3,TILE,1);
    ctx.fillStyle='rgba(0,0,0,.14)';
    ctx.fillRect(x,y+TILE-5,TILE,5);
    if((tx+ty)%3===0){ctx.fillStyle='rgba(40,32,26,.22)';ctx.fillRect(x+7,y+12,11,2)}
    if(hash2>.6){ctx.fillStyle=isRoad?'rgba(120,115,105,.18)':'rgba(90,70,50,.20)';ctx.fillRect(x+(hash*22)%22,y+(hash2*22)%22,4,2)}
    ctx.fillStyle=isRoad?'rgba(180,175,165,.06)':'rgba(160,130,95,.05)';
    ctx.fillRect(x+2,y+TILE/2-1,TILE-4,1);
  }
  if(type===T.WATER){
    const t=performance.now()/1000;
    ctx.fillStyle='rgba(40,90,110,.25)';ctx.fillRect(x,y,TILE,TILE);
    const wave1=(Math.sin(t*1.2+tx*0.7+ty*0.4)+1)*.5;
    const wave2=(Math.sin(t*0.9+tx*0.3-ty*0.6)+1)*.5;
    ctx.fillStyle='rgba(150,210,230,.18)';
    ctx.fillRect(x+3,y+5+wave1*6,TILE-10,2);
    ctx.fillStyle='rgba(180,230,245,.12)';
    ctx.fillRect(x+10,y+18+wave2*5,TILE-14,1);
    if(hash>.7){ctx.fillStyle='rgba(255,255,255,.08)';ctx.fillRect(x+(hash*20)%20,y+10+wave1*4,3,1)}
  }
  if(type===T.STONE){
    ctx.fillStyle='rgba(80,82,84,.30)';
    ctx.fillRect(x,y,TILE,TILE);
    ctx.fillStyle='rgba(255,255,255,.04)';
    if((tx*11+ty*5)%4===0){ctx.fillRect(x+7,y+9,9,3);ctx.fillRect(x+20,y+20,6,2)}
    ctx.fillStyle='rgba(0,0,0,.12)';
    ctx.fillRect(x+2,y+TILE-4,TILE-4,3);
    if(hash>.5){ctx.fillStyle='rgba(50,52,55,.25)';ctx.fillRect(x+(hash*22)%20,y+(hash2*20)%18,5,4)}
  }
  if(type===T.DARK){
    ctx.fillStyle='rgba(10,8,12,.35)';ctx.fillRect(x,y,TILE,TILE);
    if(hash>.7){ctx.fillStyle='rgba(30,20,40,.20)';ctx.fillRect(x+(hash*24)%24,y+(hash2*24)%24,3,3)}
  }
}
function drawTree(x,y,s){
  ctx.save();
  const shadowBlur=6*s;
  ctx.fillStyle='rgba(0,0,0,.28)';ctx.beginPath();ctx.ellipse(x+6*s,y+12*s,16*s,7*s,-.12,0,Math.PI*2);ctx.fill();

  ctx.fillStyle='#3d2a1a';ctx.fillRect(x-4*s,y-4*s,8*s,26*s);
  ctx.fillStyle='#5a3d24';ctx.fillRect(x-3*s,y-3*s,3*s,24*s);
  ctx.fillStyle='rgba(0,0,0,.18)';ctx.fillRect(x+1*s,y-2*s,3*s,23*s);

  const trunkY=y-8*s;
  ctx.fillStyle='#0d2415';
  ctx.beginPath();ctx.arc(x,trunkY-4*s,20*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x-12*s,trunkY-14*s,13*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x+13*s,trunkY-12*s,12*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x-2*s,trunkY-22*s,14*s,0,Math.PI*2);ctx.fill();

  ctx.fillStyle='#1e4a2c';
  ctx.beginPath();ctx.arc(x-3*s,trunkY-6*s,15*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x-13*s,trunkY-16*s,10*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x+11*s,trunkY-14*s,9*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x-4*s,trunkY-24*s,11*s,0,Math.PI*2);ctx.fill();

  ctx.fillStyle='#2d6b3e';
  ctx.beginPath();ctx.arc(x-5*s,trunkY-8*s,11*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x-10*s,trunkY-18*s,7*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x+9*s,trunkY-16*s,6*s,0,Math.PI*2);ctx.fill();

  ctx.fillStyle='rgba(140,200,120,.10)';
  ctx.beginPath();ctx.arc(x-8*s,trunkY-18*s,5*s,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x+2*s,trunkY-12*s,4*s,0,Math.PI*2);ctx.fill();

  ctx.restore();
}
function drawStructure(s,c){
  const x=s.x*TILE-c.x,y=s.y*TILE-c.y,w=s.w*TILE,h=s.h*TILE;if(x+w<0||y+h<0||x>canvas.width||y>canvas.height)return;
  ctx.save();
  ctx.fillStyle='rgba(0,0,0,.30)';ctx.fillRect(x+10,y+12,w,h);

  if(s.type==='tower'){
    ctx.fillStyle='#3a444d';ctx.fillRect(x+24,y+40,w-48,h-40);
    ctx.strokeStyle='#9aabb8';ctx.lineWidth=4;
    ctx.beginPath();ctx.moveTo(x+w/2,y);ctx.lineTo(x+34,y+h);ctx.stroke();
    ctx.beginPath();ctx.moveTo(x+w/2,y);ctx.lineTo(x+w-34,y+h);ctx.stroke();
    ctx.beginPath();ctx.moveTo(x+38,y+h*.55);ctx.lineTo(x+w-38,y+h*.55);ctx.stroke();
    ctx.beginPath();ctx.moveTo(x+42,y+h*.30);ctx.lineTo(x+w-42,y+h*.30);ctx.stroke();
    ctx.fillStyle='#8a96a0';ctx.fillRect(x+26,y+h-12,w-52,12);
    ctx.fillStyle='#b63d3d';ctx.fillRect(x+w/2-4,y+4,8,8);
    ctx.fillStyle='rgba(255,100,100,.3)';ctx.beginPath();ctx.arc(x+w/2,y+8,14,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#13191e';ctx.fillRect(x+w*.42,y+h-38,32,38);
    ctx.fillStyle='rgba(80,160,120,.15)';ctx.fillRect(x+w*.42,y+h-38,32,38);
    ctx.restore();return;
  }
  const wall=s.type==='cabin'?'#5e4632':s.type==='station'?'#5a5751':'#63584b';
  ctx.fillStyle=wall;ctx.fillRect(x,y,w,h);
  ctx.fillStyle='rgba(255,255,255,.04)';for(let yy=y+14;yy<y+h;yy+=18)ctx.fillRect(x+5,yy,w-10,1);
  ctx.fillStyle='rgba(0,0,0,.10)';ctx.fillRect(x,y,w,3);ctx.fillRect(x,y,3,h);
  ctx.fillStyle='rgba(255,255,255,.03)';ctx.fillRect(x+w-3,y,3,h);

  ctx.fillStyle='#3a2e26';ctx.beginPath();ctx.moveTo(x-12,y+11);ctx.lineTo(x+w/2,y-38);ctx.lineTo(x+w+12,y+11);ctx.closePath();ctx.fill();
  ctx.fillStyle='#4a3a30';ctx.beginPath();ctx.moveTo(x-12,y+11);ctx.lineTo(x+w/2,y-38);ctx.lineTo(x+w/2,y+11);ctx.closePath();ctx.fill();
  ctx.fillStyle='#2a221c';ctx.fillRect(x-12,y+9,w+24,5);

  ctx.fillStyle='#1a1f24';ctx.fillRect(x+w*.42,y+h-40,32,40);
  ctx.fillStyle='#2a2018';ctx.fillRect(x+w*.42+2,y+h-38,28,2);
  ctx.fillStyle='#c9a84a';ctx.beginPath();ctx.arc(x+w*.42+25,y+h-20,2,0,Math.PI*2);ctx.fill();

  const lit=(s.type==='cabin'&&state.flags.powered);
  const winW=Math.min(34,w*.22),winH=26;
  const winY=y+h*.30;
  const wx1=x+w*.18,wx2=x+w-w*.18-winW;
  ctx.fillStyle=lit?'#ffd894':'#5a7285';
  ctx.fillRect(wx1,winY,winW,winH);ctx.fillRect(wx2,winY,winW,winH);
  ctx.strokeStyle=lit?'#8a6a30':'#2a3a45';ctx.lineWidth=2;
  ctx.strokeRect(wx1,winY,winW,winH);ctx.strokeRect(wx2,winY,winW,winH);
  ctx.beginPath();ctx.moveTo(wx1+winW/2,winY);ctx.lineTo(wx1+winW/2,winY+winH);ctx.moveTo(wx1,winY+winH/2);ctx.lineTo(wx1+winW,winY+winH/2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(wx2+winW/2,winY);ctx.lineTo(wx2+winW/2,winY+winH);ctx.moveTo(wx2,winY+winH/2);ctx.lineTo(wx2+winW,winY+winH/2);ctx.stroke();

  if(lit){
    ctx.fillStyle='rgba(255,211,140,.10)';ctx.fillRect(wx1-12,winY-12,winW+24,winH+24);
    ctx.fillStyle='rgba(255,211,140,.10)';ctx.fillRect(wx2-12,winY-12,winW+24,winH+24);
  }

  if(s.type==='station'){
    ctx.fillStyle='#3a3833';ctx.fillRect(x-6,y+h-10,w+12,10);
    ctx.fillStyle='#7a7568';for(let i=0;i<4;i++)ctx.fillRect(x-4+i*(w/4),y+h-8,w/4-4,6);
  }
  ctx.restore();
}
function drawInteractable(o,c){
  const x=o.x-c.x,y=o.y-c.y;if(x<-60||y<-60||x>canvas.width+60||y>canvas.height+60)return;
  ctx.save();
  ctx.fillStyle='rgba(0,0,0,.28)';ctx.beginPath();ctx.ellipse(x,y+15,13,6,0,0,Math.PI*2);ctx.fill();
  if(o.type==='npc'){
    ctx.fillStyle='#e0d8c8';ctx.beginPath();ctx.arc(x,y-12,8,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#c9bfa8';ctx.beginPath();ctx.arc(x,y-12,8,Math.PI,0);ctx.fill();
    ctx.fillStyle='#2a3540';ctx.beginPath();ctx.arc(x-2,y-13,1.5,0,Math.PI*2);ctx.fill();
    ctx.beginPath();ctx.arc(x+2,y-13,1.5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#536b80';ctx.fillRect(x-8,y-4,16,22);
    ctx.fillStyle='#3d5569';ctx.fillRect(x-8,y-4,16,4);
    ctx.fillStyle='#263746';ctx.fillRect(x-8,y+15,16,5);
    ctx.fillStyle='#1a2530';ctx.fillRect(x-7,y+18,5,6);ctx.fillRect(x+2,y+18,5,6);
  } else if(o.type==='item'){
    const bob=Math.sin(performance.now()/400+o.x)*2;
    ctx.fillStyle='rgba(255,255,200,.15)';ctx.beginPath();ctx.arc(x,y+bob,16,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#dcebb4';ctx.fillRect(x-8,y-8+bob,16,16);
    ctx.fillStyle='#eef5d0';ctx.fillRect(x-8,y-8+bob,16,4);
    ctx.strokeStyle='rgba(255,255,255,.7)';ctx.lineWidth=1.5;ctx.strokeRect(x-8,y-8+bob,16,16);
    ctx.fillStyle='#8a9a5a';ctx.fillRect(x-2,y-2+bob,4,4);
  } else if(o.type==='machine'||o.type==='console'){
    ctx.fillStyle='#3d4a55';ctx.fillRect(x-18,y-15,36,30);
    ctx.fillStyle='#2a343d';ctx.fillRect(x-18,y-15,36,5);
    ctx.fillStyle='#1a222a';ctx.fillRect(x-13,y-9,17,12);
    const onColor=o.type==='console'?'#6fe08a':(state.flags.powered?'#6fe08a':'#dd5a50');
    ctx.fillStyle=onColor;ctx.fillRect(x+8,y-8,6,6);
    ctx.fillStyle='rgba(0,0,0,.3)';ctx.fillRect(x+8,y-2,6,3);
    if(o.type==='console'||state.flags.powered){
      ctx.fillStyle='rgba(110,220,140,.18)';ctx.beginPath();ctx.arc(x+11,y-5,12,0,Math.PI*2);ctx.fill();
    }
    ctx.fillStyle='#556570';ctx.fillRect(x-16,y+10,32,5);
  } else if(o.type==='door'){
    ctx.fillStyle='#2a221c';ctx.fillRect(x-13,y-22,26,44);
    ctx.fillStyle='#3a2e24';ctx.fillRect(x-11,y-20,22,3);
    ctx.fillStyle='#4a3a2c';ctx.fillRect(x-11,y-17,22,40);
    ctx.fillStyle='#b2a26d';ctx.beginPath();ctx.arc(x+7,y+1,2.5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='rgba(0,0,0,.15)';ctx.fillRect(x-11,y-17,22,2);
  } else if(o.type==='cave'){
    ctx.fillStyle='#0a0e11';ctx.beginPath();ctx.arc(x,y,26,Math.PI,0);ctx.lineTo(x+26,y+18);ctx.lineTo(x-26,y+18);ctx.closePath();ctx.fill();
    ctx.fillStyle='#1a1f23';ctx.beginPath();ctx.arc(x,y,22,Math.PI,0);ctx.lineTo(x+22,y+14);ctx.lineTo(x-22,y+14);ctx.closePath();ctx.fill();
    ctx.strokeStyle='rgba(160,170,175,.3)';ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle='rgba(80,90,100,.25)';ctx.fillRect(x-22,y+12,44,6);
  } else if(o.type==='dog'){
    const wag=Math.sin(performance.now()/200)*3;
    ctx.fillStyle='#c2a071';ctx.fillRect(x-12,y-5,22,11);
    ctx.fillRect(x+8,y-13,9,10);
    ctx.fillStyle='#a08050';ctx.fillRect(x-12,y-5,22,3);
    ctx.fillStyle='#4c3728';ctx.fillRect(x+13,y-11,2.5,2.5);
    ctx.fillStyle='#3a2a1e';ctx.fillRect(x+16,y-8,2,2);
    ctx.fillRect(x-10,y+6,4,6);ctx.fillRect(x+6,y+6,4,6);
    ctx.fillStyle='#c2a071';ctx.fillRect(x-14,y-2+wag,4,3);
  } else {
    ctx.fillStyle='#786b58';ctx.fillRect(x-12,y-10,24,20);
    ctx.fillStyle='#8a7d68';ctx.fillRect(x-12,y-10,24,4);
  }
  if(nearest===o&&!overlayOpen){
    const pulse=(Math.sin(performance.now()/200)+1)*.5;
    ctx.strokeStyle=`rgba(225,242,255,${.5+pulse*.4})`;ctx.lineWidth=2.5;ctx.beginPath();ctx.arc(x,y,24,0,Math.PI*2);ctx.stroke();
  }
  ctx.restore();
}
function drawPlayer(c){
  const x=player.x-c.x,y=player.y-c.y;
  ctx.save();
  const walk=Math.hypot(player.facingX,player.facingY)>0&&!overlayOpen?Math.sin(performance.now()/100)*2:0;
  ctx.fillStyle='rgba(0,0,0,.3)';ctx.beginPath();ctx.ellipse(x,y+26,12,5.5,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#e8eef3';ctx.beginPath();ctx.arc(x,y-9,8.5,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#cdd6de';ctx.beginPath();ctx.arc(x,y-9,8.5,Math.PI,0);ctx.fill();
  ctx.fillStyle='#1a1f24';ctx.beginPath();ctx.arc(x-2.5,y-10,1.6,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.arc(x+2.5,y-10,1.6,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#314a63';ctx.fillRect(x-8,y-1,16,22);
  ctx.fillStyle='#3d5a78';ctx.fillRect(x-8,y-1,16,5);
  ctx.fillStyle='#1a1f24';ctx.fillRect(x-8,y+17,16,5);
  ctx.fillStyle='#131719';
  ctx.fillRect(x-7,y+20+walk,5,10);
  ctx.fillRect(x+2,y+20-walk,5,10);
  if(state.hasFlashlight){
    ctx.fillStyle='#1a1f24';
    ctx.fillRect(x+player.facingX*5-2,y+6+player.facingY*3-2,4,4);
    if(state.flashlight){
      ctx.fillStyle='rgba(255,250,220,.5)';
      ctx.beginPath();ctx.arc(x+player.facingX*7,y+6+player.facingY*4,3,0,Math.PI*2);ctx.fill();
    }
  }
  ctx.restore();
}
function drawParticles(c){
  const t=performance.now()/1000;
  for(const p of particles){
    const px=p.x-c.x,py=p.y-c.y;
    if(px<-20||py<-20||px>canvas.width+20||py>canvas.height+20)continue;
    if(p.type==='firefly'){
      const glow=(Math.sin(p.phase*3)+1)*.5;
      ctx.fillStyle=`rgba(180,255,160,${.15+glow*.35})`;
      ctx.beginPath();ctx.arc(px,py,p.size+3+glow*2,0,Math.PI*2);ctx.fill();
      ctx.fillStyle=`rgba(220,255,200,${.6+glow*.4})`;
      ctx.beginPath();ctx.arc(px,py,p.size,0,Math.PI*2);ctx.fill();
    } else if(p.type==='dust'){
      ctx.fillStyle=`rgba(200,210,220,${.15+Math.sin(p.phase)*.08})`;
      ctx.beginPath();ctx.arc(px,py,p.size,0,Math.PI*2);ctx.fill();
    } else {
      ctx.save();ctx.translate(px,py);ctx.rotate(p.phase*.5);
      ctx.fillStyle='rgba(120,90,60,.5)';
      ctx.fillRect(-p.size,-p.size*.4,p.size*2,p.size*.8);
      ctx.restore();
    }
  }
}
function nightStrength(){
  const h=state.time/60;
  if(h>=21||h<4.5)return .78;
  if(h>=19&&h<21)return .45+(h-19)*.165;
  if(h>=4.5&&h<6.5)return .78-(h-4.5)*.28;
  return 0;
}
function punchRadial(x,y,radius,inner=12,power=1){
  const g=dctx.createRadialGradient(x,y,inner,x,y,radius);
  g.addColorStop(0,`rgba(0,0,0,${power})`);g.addColorStop(.55,`rgba(0,0,0,${power*.72})`);g.addColorStop(1,'rgba(0,0,0,0)');
  dctx.fillStyle=g;dctx.beginPath();dctx.arc(x,y,radius,0,Math.PI*2);dctx.fill();
}
function drawDarkness(c){
  const strength=nightStrength();if(strength<=0)return;
  const px=player.x-c.x,py=player.y-c.y;
  dctx.clearRect(0,0,darknessCanvas.width,darknessCanvas.height);
  dctx.globalCompositeOperation='source-over';dctx.fillStyle=`rgba(2,6,11,${strength})`;dctx.fillRect(0,0,darknessCanvas.width,darknessCanvas.height);

  dctx.globalCompositeOperation='destination-out';
  punchRadial(px,py,state.flashlight?96:68,10,state.flashlight ? 0.95 : 0.58);
  if(state.flashlight){
    const angle=Math.atan2(player.facingY,player.facingX),len=360,half=.42;
    dctx.save();dctx.beginPath();dctx.moveTo(px,py);dctx.arc(px,py,len,angle-half,angle+half);dctx.closePath();dctx.clip();
    const gx=px+player.facingX*70,gy=py+player.facingY*70;
    const beam=dctx.createRadialGradient(gx,gy,12,px,py,len);
    beam.addColorStop(0,'rgba(0,0,0,1)');beam.addColorStop(.55,'rgba(0,0,0,.85)');beam.addColorStop(.82,'rgba(0,0,0,.4)');beam.addColorStop(1,'rgba(0,0,0,0)');
    dctx.fillStyle=beam;dctx.fillRect(px-len,py-len,len*2,len*2);dctx.restore();
  }
  for(const s of structures){
    if(s.type==='cabin'&&state.flags.powered){
      const lx=(s.x+s.w/2)*TILE-c.x,ly=(s.y+s.h/2)*TILE-c.y;
      punchRadial(lx,ly,140,30,0.7);
    }
  }
  dctx.globalCompositeOperation='source-over';
  ctx.drawImage(darknessCanvas,0,0);

  const vg=ctx.createRadialGradient(canvas.width/2,canvas.height/2,Math.min(canvas.width,canvas.height)*.35,canvas.width/2,canvas.height/2,Math.max(canvas.width,canvas.height)*.75);
  vg.addColorStop(0,'rgba(0,0,0,0)');
  vg.addColorStop(1,`rgba(0,0,0,${.35+strength*.2})`);
  ctx.fillStyle=vg;ctx.fillRect(0,0,canvas.width,canvas.height);

  const flicker=Math.sin(performance.now()/90)*.015+Math.sin(performance.now()/47)*.01;
  ctx.fillStyle=`rgba(0,0,0,${.02+flicker})`;ctx.fillRect(0,0,canvas.width,canvas.height);
}
function drawMiniMap(){
  mctx.clearRect(0,0,mini.width,mini.height);const sx=mini.width/MAP_W,sy=mini.height/MAP_H;
  const colors=['#294c2f','#1d3424','#69635a','#514839','#173746','#272c2f','#585b5d'];
  for(let y=0;y<MAP_H;y+=2)for(let x=0;x<MAP_W;x+=2){mctx.fillStyle=colors[map[y][x]];mctx.fillRect(x*sx,y*sy,Math.ceil(2*sx),Math.ceil(2*sy))}
  for(const o of interactables){if(!o.active)continue;if(['npc','item','machine','door','console','cave'].includes(o.type)){mctx.fillStyle=o.type==='npc'?'#e6dfc9':'#e1ecff';mctx.fillRect((o.x/TILE)*sx-2,(o.y/TILE)*sy-2,4,4)}}
  mctx.fillStyle='#fff';mctx.beginPath();mctx.arc((player.x/TILE)*sx,(player.y/TILE)*sy,4,0,Math.PI*2);mctx.fill();
}

function intro(){
  state.flags.intro=true;
  openDialog('21:03 • Okraj Hvozdu','Autobus tě vysadil o dvě zastávky dřív. Silnice dál je zablokovaná spadlými stromy a telefon nemá signál.\n\nPřed tebou vede stará cesta do vesnice Hvozd. Z lesa se ozve krátké zapraskání, skoro jako rádio.',[
    {text:'Vyrazit do vesnice'}
  ]);
}

loadGame();
if(state.flags.towerOpen){towerDoor.active=false;towerConsole.active=true;}
updateQuestProgress();
if(!state.flags.intro)setTimeout(intro,250);

function loop(now){const dt=Math.min((now-last)/1000,.033);last=now;update(dt);render();requestAnimationFrame(loop)}
requestAnimationFrame(loop);
})();
</script>
