<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>The Last Signal - Extended v3</title>
<style>
  :root{
    --panel:rgba(7,12,18,.84);--text:#eaf2fb;--muted:#9aaabd;
    --accent:#d7eaff;--good:#a9efbb;--warn:#ffe39a;
    --hud-gap:14px
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;overflow:hidden;background:#05080c;color:var(--text);font-family:Inter,system-ui,Segoe UI,Arial,sans-serif}
  #game{display:block;width:100vw;height:100vh;background:#0b1114}

  #hud{position:fixed;inset:0;pointer-events:none;z-index:20}
  .panel{
    background:var(--panel);border:1px solid rgba(255,255,255,.10);
    backdrop-filter:blur(7px);box-shadow:0 8px 28px rgba(0,0,0,.28),inset 0 1px rgba(255,255,255,.025)
  }
  #topLeft{position:absolute;left:var(--hud-gap);top:var(--hud-gap);padding:11px 13px;border-radius:12px;min-width:270px;max-width:min(440px,45vw)}
  #topRight{position:absolute;right:var(--hud-gap);top:var(--hud-gap);padding:11px 13px;border-radius:12px;min-width:190px;text-align:right}
  #questBox{position:absolute;left:var(--hud-gap);bottom:var(--hud-gap);padding:11px 13px;border-radius:12px;width:min(390px,32vw);min-height:64px}
  #miniMap{position:absolute;right:var(--hud-gap);bottom:var(--hud-gap);width:200px;height:142px;border-radius:12px;overflow:hidden;padding:3px}
  #miniCanvas{width:100%;height:100%;display:block;border-radius:9px;background:#0a0d10}
  #prompt{
    position:absolute;left:50%;bottom:22px;transform:translateX(-50%);
    padding:9px 14px;border-radius:10px;font-weight:750;display:none;
    max-width:min(420px,34vw);text-align:center;white-space:normal
  }
  #toast{
    position:absolute;left:50%;top:18px;transform:translateX(-50%);
    padding:9px 14px;border-radius:10px;opacity:0;transition:opacity .15s;
    max-width:38vw;text-align:center
  }
  .small{font-size:12px;color:var(--muted);line-height:1.35}
  .bar{height:8px;background:#25313e;border-radius:999px;overflow:hidden;margin-top:5px}
  .bar>div{height:100%;background:linear-gradient(90deg,#9bc7ef,#e6f4ff);transition:width .15s}

  #dialog,#inventory,#help,#endScreen{
    position:fixed;inset:0;background:rgba(0,0,0,.62);display:none;align-items:center;justify-content:center;
    padding:18px;z-index:60
  }
  #endScreen{z-index:80}
  .modal{
    width:min(720px,94vw);max-height:82vh;overflow:auto;background:#111922;
    border:1px solid rgba(255,255,255,.11);border-radius:15px;padding:18px;
    box-shadow:0 22px 70px rgba(0,0,0,.58)
  }
  .modal h2,.modal h3{margin-top:0}
  #dialogText{white-space:pre-line;line-height:1.55}
  .choices{display:grid;gap:8px;margin-top:14px}
  button{font:inherit;color:#eef6ff;background:#1a2634;border:1px solid #34495f;border-radius:10px;padding:10px 12px;cursor:pointer;text-align:left}
  button:hover{background:#24364a;border-color:#49647e}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:9px}
  .item{padding:10px;border-radius:9px;background:#17212c;border:1px solid #293948}
  kbd{background:#1a2634;border:1px solid #415467;border-bottom-width:2px;border-radius:5px;padding:1px 6px}
  .sep{height:1px;background:rgba(255,255,255,.08);margin:12px 0}

  @media (max-width:1050px){
    #questBox{width:300px;bottom:170px}
    #miniMap{width:170px;height:121px}
    #prompt{max-width:340px}
  }
  @media (max-width:760px){
    :root{--hud-gap:8px}
    #topLeft{left:8px;right:8px;max-width:none;min-width:0}
    #topRight{top:94px;right:8px;min-width:150px}
    #toast{top:146px;max-width:calc(100vw - 20px)}
    #miniMap{display:none}
    #questBox{left:8px;right:8px;bottom:68px;width:auto;min-height:0}
    #prompt{bottom:10px;max-width:calc(100vw - 16px);width:max-content}
  }
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="hud">
  <div id="topLeft" class="panel">
    <b>THE LAST SIGNAL</b><div class="small">E interakce • F svítilna • R baterie • I inventář • J úkoly • H nápověda</div>
    <div style="margin-top:8px">Baterie: <span id="batteryText">0%</span></div>
    <div class="bar"><div id="batteryBar" style="width:0%"></div></div>
  </div>
  <div id="topRight" class="panel"><div id="timeText">21:00</div><div class="small" id="zoneText">Okraj lesa</div></div>
  <div id="questBox" class="panel"><b>Aktuální úkol</b><div id="questText" style="margin-top:5px">Najdi cestu do vesnice.</div></div>
  <div id="prompt" class="panel"></div>
  <div id="toast" class="panel"></div>
  <div id="miniMap" class="panel"><canvas id="miniCanvas" width="380" height="270"></canvas></div>
</div>

<div id="dialog"><div class="modal"><h3 id="dialogTitle"></h3><div id="dialogText"></div><div id="dialogChoices" class="choices"></div></div></div>
<div id="inventory"><div class="modal"><h2>Inventář</h2><div id="inventoryGrid" class="grid"></div><div class="sep"></div><button id="closeInventory">Zavřít</button></div></div>
<div id="help"><div class="modal"><h2>Ovládání</h2><p><kbd>WASD</kbd> / šipky: pohyb • <kbd>E</kbd>: interakce • <kbd>F</kbd>: svítilna • <kbd>R</kbd>: použít baterii • <kbd>I</kbd>: inventář • <kbd>J</kbd>: přehled úkolů • <kbd>H</kbd>: nápověda • <kbd>Esc</kbd>: zavřít okno</p><p class="small">Hru můžeš uložit u rádia v chatě. Některé dialogy a úkoly mění konec hry.</p><button id="closeHelp">Zavřít</button></div></div>
<div id="endScreen"><div class="modal"><h2 id="endTitle"></h2><div id="endText" style="white-space:pre-line;line-height:1.5"></div><div class="choices"><button onclick="location.reload()">Hrát znovu</button></div></div></div>

<script>
(() => {
'use strict';

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const mini = document.getElementById('miniCanvas');
const mctx = mini.getContext('2d');
const darknessCanvas = document.createElement('canvas');
const dctx = darknessCanvas.getContext('2d');

function resize(){
  canvas.width=innerWidth;canvas.height=innerHeight;
  darknessCanvas.width=canvas.width;darknessCanvas.height=canvas.height;
}
addEventListener('resize',resize);resize();

const TILE=32, MAP_W=160, MAP_H=112;
const T={GRASS:0,FOREST:1,ROAD:2,DIRT:3,WATER:4,DARK:5,STONE:6};
const map=Array.from({length:MAP_H},()=>Array(MAP_W).fill(T.GRASS));
const roadMask=Array.from({length:MAP_H},()=>Array(MAP_W).fill(false));
const rng = mulberry32(184731);

function mulberry32(a){return function(){let t=a+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
function dist(ax,ay,bx,by){return Math.hypot(ax-bx,ay-by)}

function paintCircle(cx,cy,r,type,mask=false){
  for(let y=Math.floor(cy-r);y<=Math.ceil(cy+r);y++) for(let x=Math.floor(cx-r);x<=Math.ceil(cx+r);x++){
    if(x<0||y<0||x>=MAP_W||y>=MAP_H) continue;
    if(dist(x,y,cx,cy)<=r){map[y][x]=type;if(mask)roadMask[y][x]=true;}
  }
}
function paintPath(points,width=2,type=T.ROAD){
  for(let i=0;i<points.length-1;i++){
    const [x1,y1]=points[i],[x2,y2]=points[i+1];
    const steps=Math.ceil(dist(x1,y1,x2,y2)*3);
    for(let s=0;s<=steps;s++){
      const t=s/steps;paintCircle(x1+(x2-x1)*t,y1+(y2-y1)*t,width,type,true);
    }
  }
}

// Základ lesa
for(let y=0;y<MAP_H;y++) for(let x=0;x<MAP_W;x++){
  if(rng()<0.62) map[y][x]=T.FOREST;
  if(rng()<0.035) map[y][x]=T.DARK;
}

// Hlavní oblasti
paintCircle(25,28,12,T.GRASS);      // vesnice
paintCircle(65,39,8,T.GRASS);       // chata
paintCircle(110,25,9,T.GRASS);      // vysílač
paintCircle(130,82,10,T.STONE);     // lom / jeskyně
paintCircle(47,87,10,T.GRASS);      // nádraží
for(let y=68;y<93;y++) for(let x=82;x<105;x++) if(((x-93)/13)**2+((y-80)/10)**2<1) map[y][x]=T.WATER;

// Silnice a lesní cesty. Stromy se na roadMask už nikdy nekreslí.
paintPath([[5,55],[18,45],[25,28],[48,31],[65,39],[82,36],[110,25]],2.2,T.ROAD);
paintPath([[25,28],[31,48],[29,67],[47,87]],1.8,T.DIRT);
paintPath([[65,39],[72,56],[81,69],[93,72]],1.4,T.DIRT);
paintPath([[93,72],[110,70],[130,82]],1.4,T.DIRT);
paintPath([[47,87],[71,94],[103,96],[130,82]],1.2,T.DIRT);
paintPath([[110,25],[125,40],[137,53]],1.1,T.DIRT);

// Startovní mýtina
paintCircle(7,55,5,T.GRASS);

const structures=[
 {x:21,y:23,w:6,h:5,type:'house',label:'Dům správce'},
 {x:30,y:31,w:5,h:4,type:'house',label:'Dům Ley'},
 {x:61,y:35,w:8,h:6,type:'cabin',label:'Lesní chata'},
 {x:106,y:20,w:7,h:8,type:'tower',label:'Reléová stanice'},
 {x:43,y:83,w:10,h:5,type:'station',label:'Opuštěná zastávka'}
];

const trees=[];
for(let y=1;y<MAP_H-1;y++) for(let x=1;x<MAP_W-1;x++){
  if(map[y][x]!==T.FOREST) continue;
  let nearRoad=false;
  for(let oy=-1;oy<=1;oy++) for(let ox=-1;ox<=1;ox++) if(roadMask[y+oy]?.[x+ox]) nearRoad=true;
  const nearStructure=structures.some(s=>x>=s.x-2&&x<=s.x+s.w+1&&y>=s.y-2&&y<=s.y+s.h+1);
  if(!nearRoad && !nearStructure && rng()<0.44) trees.push({x:x+rng()*.6-.3,y:y+rng()*.6-.3,s:0.8+rng()*.5});
}

const state={
  time:21*60,
  flashlight:false,
  battery:0,
  hasFlashlight:false,
  inventory:{},
  flags:{intro:false,talkedMarek:false,talkedLea:false,leaBatteryGiven:false,foundNote:false,foundKey:false,powered:false,heardTape:false,foundFuse:false,towerOpen:false,signalSent:false,dogHelp:false,stationCode:false,caveTruth:false,stationBoxTaken:false,dataModuleTaken:false},
  questStage:0,
  journal:[],
  choiceTrust:0,
  ending:null
};

const player={x:7*TILE,y:55*TILE,r:10,speed:185,facingX:1,facingY:0};
let keys={},dialogOpen=false,overlayOpen=false,last=performance.now(),nearest=null,dialogSerial=0;

const particles=[];
for(let i=0;i<120;i++){
  const r=rng();
  particles.push({
    x:rng()*MAP_W*TILE,
    y:rng()*MAP_H*TILE,
    vx:(rng()-.5)*6,
    vy:(rng()-.5)*6-2,
    size:rng()*2+1,
    phase:rng()*Math.PI*2,
    type:r<.35?'firefly':(r<.75?'dust':'leaf')
  });
}

const quests=[
 'Najdi cestu do vesnice.',
 'Promluv se správcem Markem.',
 'Najdi lesní chatu a zjisti, proč vysílač mlčí.',
 'Najdi baterku a náhradní pojistku.',
 'Zprovozni generátor u chaty.',
 'Zjisti kód k reléové stanici.',
 'Dostaň se k reléové stanici.',
 'Rozhodni, jaký signál odešleš.'
];

function addItem(name,count=1){state.inventory[name]=(state.inventory[name]||0)+count;toast(`Získáno: ${name}${count>1?' ×'+count:''}`)}
function hasItem(name,count=1){return (state.inventory[name]||0)>=count}
function removeItem(name,count=1){if(!hasItem(name,count))return false;state.inventory[name]-=count;if(state.inventory[name]<=0)delete state.inventory[name];return true}
function addJournal(text){if(!state.journal.includes(text))state.journal.push(text)}
function setQuest(n){state.questStage=Math.max(state.questStage,n);document.getElementById('questText').textContent=quests[state.questStage]||'Příběh dokončen.'}
function toast(text){const e=document.getElementById('toast');e.textContent=text;e.style.opacity='1';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.opacity='0',1800)}
function refreshOverlayState(){
  const ids=['dialog','inventory','help','endScreen'];
  overlayOpen=ids.some(id=>document.getElementById(id).style.display==='flex');
}
function addBatteryCell(count=1){addItem('Bateriový článek',count)}
function useBatteryCell(){
  if(!state.hasFlashlight)return toast('Nejdřív musíš najít svítilnu.');
  if(!hasItem('Bateriový článek'))return toast('Nemáš žádný náhradní bateriový článek.');
  if(state.battery>=98)return toast('Svítilna už je skoro plně nabitá.');
  removeItem('Bateriový článek');
  state.battery=Math.min(100,state.battery+45);
  toast('Vyměnil jsi baterii ve svítilně.');
}
function updateQuestProgress(){
  const tx=player.x/TILE,ty=player.y/TILE;
  if(state.flags.talkedMarek && state.questStage<2)setQuest(2);
  if(state.questStage===2 && dist(tx,ty,65,39)<10)setQuest(3);
  if(state.hasFlashlight && state.flags.foundFuse && state.questStage<4)setQuest(4);
  if(state.flags.powered && state.questStage<5)setQuest(5);
  if(state.flags.stationCode && state.questStage<6)setQuest(6);
  if(state.flags.towerOpen && state.questStage<7)setQuest(7);
}

const interactables=[];
function addInteractable(o){o.active=o.active!==false;o.radius=o.radius||58;interactables.push(o);return o}
function worldPos(tx,ty){return {x:tx*TILE+TILE/2,y:ty*TILE+TILE/2}}
function npc(id,name,tx,ty,talk){const p=worldPos(tx,ty);return addInteractable({id,type:'npc',name,x:p.x,y:p.y,prompt:`E • Promluvit s ${name}`,talk,draw:true})}
function object(id,name,tx,ty,prompt,action,drawType='object'){const p=worldPos(tx,ty);return addInteractable({id,type:drawType,name,x:p.x,y:p.y,prompt,action,draw:true})}
function item(id,name,tx,ty,action){const p=worldPos(tx,ty);return addInteractable({id,type:'item',name,x:p.x,y:p.y,prompt:`E • Sebrat ${name}`,action,draw:true})}

npc('marek','Markem',24,29,()=>{
  state.flags.talkedMarek=true;setQuest(2);
  openDialog('Marek','„Vysílač zhasl před třemi nocemi. Od té doby se v lese objevují světla, která tam nemají být.\n\nJestli chceš zjistit, co se stalo, najdi chatu starého technika. Měla by být východně po silnici.“',[
    {text:'„Co je na vysílači tak důležité?“',action:()=>openDialog('Marek','„Dřív jen přeposílal nouzové zprávy. Teď ale každou noc vysílá něco vlastního. Nikdo neví odkud se to bere.“',[{text:'Rozumím.'}])},
    {text:'„Půjdu tam.“',action:()=>{state.choiceTrust++;toast('Marek si zapamatoval tvé rozhodnutí.')}}
  ]);
});

npc('lea','Leou',32,36,()=>{
  state.flags.talkedLea=true;
  openDialog('Lea','„Jestli jdeš k vysílači, neber všechno, co uslyšíš, jako pravdu. Ta věc umí zopakovat hlas člověka přesně tak, jak ho znáš.“',[
    {text:'„Ty jsi to slyšela?“',action:()=>openDialog('Lea','„Ano. Hlas mého bratra. Jenže ten je už roky pryč. Proto jsem tam přestala chodit.“',[{text:'Tohle se mi nelíbí.'}])},
    {text:'„Máš něco, co by mi pomohlo?“',action:()=>{if(!state.flags.leaBatteryGiven){state.flags.leaBatteryGiven=true;addBatteryCell();toast('Lea ti dala náhradní bateriový článek.')}else toast('Lea už ti jednu baterii dala.')}}
  ]);
});

npc('jan','Janem',48,88,()=>{
  openDialog('Jan, bývalý výpravčí','„Ta stanice už dávno nefunguje. Ale pod nástupištěm zůstala servisní skříňka. Technik si tam schovával čísla k relé.“',[
    {text:'„Jak se do ní dostanu?“',action:()=>openDialog('Jan','„Je zamčená starým trojhranem. Klíč prý skončil u chaty, někde poblíž dřevníku.“',[{text:'Díky.'}])},
    {text:'„Proč jste tu ještě vy?“',action:()=>openDialog('Jan','„Někdo musí vědět, co tu bývalo. Jinak si les vymyslí vlastní verzi.“',[{text:'...'}])}
  ]);
});

npc('iva','Ivou',117,68,()=>{
  openDialog('Iva','„V jeskyni pod lomem jsem našla kabel, který vede směrem k vysílači. Není na žádné staré mapě.“',[
    {text:'„Ukážeš mi vstup?“',action:()=>{state.flags.dogHelp=true;toast('Na mapě se objevil lom.')}},
    {text:'„Zůstanu u vysílače.“',action:()=>{state.choiceTrust--;toast('Iva ti přestala úplně věřit.')}}
  ]);
});

item('flashlight','baterku',67,42,()=>{
  state.hasFlashlight=true;state.battery=Math.max(state.battery,38);addItem('Svítilna');
  interactables.find(x=>x.id==='flashlight').active=false;updateQuestProgress();
});
item('battery1','bateriový článek',37,55,()=>{addBatteryCell();interactables.find(x=>x.id==='battery1').active=false});
item('battery2','bateriový článek',102,91,()=>{addBatteryCell();interactables.find(x=>x.id==='battery2').active=false});
item('fuse','náhradní pojistku',53,90,()=>{state.flags.foundFuse=true;addItem('Pojistka');interactables.find(x=>x.id==='fuse').active=false;updateQuestProgress()});
item('key','starý servisní klíč',70,35,()=>{state.flags.foundKey=true;addItem('Servisní klíč');interactables.find(x=>x.id==='key').active=false});
item('tape','kazetu',63,42,()=>{addItem('Kazeta 04');interactables.find(x=>x.id==='tape').active=false});
item('note','poznámku',11,52,()=>{
  state.flags.foundNote=true;addJournal('Poznámka z lesa: „Pokud se světlo rozsvítí samo, neodpovídej na hlas z rádia.“');
  openDialog('Pomačkaná poznámka','„Pokud se světlo rozsvítí samo, neodpovídej na hlas z rádia.“',[{text:'Vzít poznámku',action:()=>{addItem('Pomačkaná poznámka');interactables.find(x=>x.id==='note').active=false}},{text:'Nechat ji ležet'}]);
});

object('generator','generátor',59,41,'E • Prohlédnout generátor',()=>{
  if(state.flags.powered)return openDialog('Generátor','Motor běží nepravidelně, ale drží. Pro tuto noc to musí stačit.',[{text:'Zavřít'}]);
  if(!hasItem('Pojistka'))return openDialog('Generátor','Chybí hlavní pojistka. Bez ní ho nespustíš.',[{text:'Zavřít'}]);
  openDialog('Generátor','Do držáku přesně pasuje náhradní pojistka.',[
    {text:'Vložit pojistku a nastartovat',action:()=>{removeItem('Pojistka');state.flags.powered=true;updateQuestProgress();toast('Generátor běží. Rádio u chaty se probudilo.')}},
    {text:'Ještě ne'}
  ]);
},'machine');

object('radio','rádio',65,42,'E • Použít rádio',()=>{
  if(!state.flags.powered)return openDialog('Rádio','Bez proudu jen praská reproduktor.',[{text:'Zavřít'}]);
  const opts=[
    {text:'Poslechnout šum',action:()=>openDialog('Rádio','Ve šumu se opakuje krátká sekvence: 1… 9… 4… 7… a potom hlas, který vysloví tvoje jméno.',[{text:'Zapsat sekvenci',action:()=>{state.flags.stationCode=true;addJournal('Kód reléové stanice: 1947.');setQuest(6)}}])},
    {text:'Uložit hru',action:()=>saveGame()}
  ];
  if(hasItem('Kazeta 04')&&!state.flags.heardTape)opts.unshift({text:'Přehrát kazetu 04',action:()=>{state.flags.heardTape=true;addJournal('Nahrávka technika: relé nereaguje na běžné nouzové vypnutí. Zdroj je pravděpodobně pod zemí.');openDialog('Kazeta 04','„…jestli to někdo poslouchá, relé už neposílá naše zprávy. Bere si hlasy z pásma a skládá z nich vlastní. Hlavní kabel vede pod lomem…“',[{text:'Zapsat poznámku'}])}});
  openDialog('Staré rádio','Kontrolka svítí. Reproduktor tiše praská.',opts);
},'machine');

object('stationBox','servisní skříňku',47,88,'E • Otevřít servisní skříňku',()=>{
  if(!hasItem('Servisní klíč'))return openDialog('Servisní skříňka','Zámek má nezvyklý trojhranný profil. Běžný klíč sem nepůjde.',[{text:'Zavřít'}]);
  state.flags.stationCode=true;addJournal('Uvnitř skříňky je štítek: NOUZOVÝ KÓD 1947.');updateQuestProgress();
  if(state.flags.stationBoxTaken)return openDialog('Servisní skříňka','Uvnitř už nic dalšího není. Na vnitřní straně dvířek zůstává štítek s kódem 1947.',[{text:'Zavřít'}]);
